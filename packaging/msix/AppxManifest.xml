<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package. build.ps1 fills {{VERSION}} (X.Y.Z.0: the Store needs the 4th part to be 0).
     Identity and display name are the ones reserved in Partner Center; see docs/STORE.md. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="devnielo.WincyClipboard"
    Publisher="CN=217EA17B-43B9-4F4E-BDA0-F142229CF27F"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wincy Clipboard</DisplayName>
    <PublisherDisplayName>devnielo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="Wincy" Executable="wincy.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wincy Clipboard"
        Description="Keyboard-first clipboard manager for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Launch at startup: HKCU\...\Run is virtualized in MSIX; settings.rs toggles this task. -->
        <uap5:Extension Category="windows.startupTask" Executable="wincy.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WincyStartup" Enabled="false" DisplayName="Wincy" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
