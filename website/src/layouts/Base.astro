---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import GitHubMark from "../components/GitHubMark.astro";
import { REPO_URL, DOWNLOAD_URL } from "../consts";
import { dictionaries, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
const t = dictionaries[lang];
const langs = Object.keys(dictionaries) as Lang[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = getAbsoluteLocaleUrl(lang);
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en")} />
    <link rel="icon" href={`${base}/logo.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#f6f5fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d1a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wincy" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.logoAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={dictionaries[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={getRelativeLocaleUrl(lang)}>
        <img src={`${base}/logo.svg`} alt="" width="32" height="32" />
        <span>Wincy</span>
      </a>
      <nav class="site-nav" aria-label={t.nav.label}>
        <a href="#features">{t.nav.features}</a>
        <a href="#shortcuts">{t.nav.shortcuts}</a>
        <a href="#privacy">{t.nav.privacy}</a>
        <a href="#install">{t.nav.install}</a>
        <a href="#faq">{t.nav.faq}</a>
      </nav>
      <div class="header-tools">
        <nav class="lang" aria-label={t.nav.language}>
          {
            langs.map((l) => (
              <a
                href={getRelativeLocaleUrl(l)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? "page" : undefined}
              >
                {l.toUpperCase()}
                <span class="sr-only"> ({dictionaries[l].languageName})</span>
              </a>
            ))
          }
        </nav>
        <a class="icon-link" href={REPO_URL} aria-label="GitHub">
          <GitHubMark />
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img src={`${base}/logo.svg`} alt={t.meta.logoAlt} width="40" height="40" loading="lazy" />
          <p>{t.footer.license}</p>
        </div>
        <ul class="footer-links">
          <li><a href={REPO_URL}>{t.footer.source}</a></li>
          <li><a href={DOWNLOAD_URL}>{t.footer.releases}</a></li>
          <li><a href={`${REPO_URL}/issues`}>{t.footer.issues}</a></li>
          <li><a href={`${REPO_URL}/blob/main/LICENSE`}>MIT</a></li>
        </ul>
        <nav class="footer-lang" aria-label={t.nav.language}>
          {
            langs.map((l) => (
              <a href={getRelativeLocaleUrl(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>
                {dictionaries[l].languageName}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
  </body>
</html>
