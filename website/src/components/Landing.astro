---
import {
  AppWindow,
  ArrowRight,
  Check,
  ChevronDown,
  ClipboardType,
  Download,
  Feather,
  HardDrive,
  Info,
  Pin,
  RefreshCw,
  Search,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";
import Base from "../layouts/Base.astro";
import GitHubMark from "./GitHubMark.astro";
import Keys from "./Keys.astro";
import Palette from "./Palette.astro";
import { DOWNLOAD_URL, REPO_URL } from "../consts";
import { dictionaries, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
const t = dictionaries[lang];
const featureIcons = {
  palette: AppWindow,
  detect: Sparkles,
  privacy: ShieldCheck,
  plain: ClipboardType,
  pin: Pin,
  search: Search,
  native: Feather,
  local: HardDrive,
  update: RefreshCw,
} as const;
type FeatureIcon = keyof typeof featureIcons;
---

<Base lang={lang}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={DOWNLOAD_URL}>
          <Download size={20} aria-hidden="true" />
          {t.hero.download}
        </a>
        <a class="btn btn-ghost" href={REPO_URL}>
          <GitHubMark />
          {t.hero.github}
        </a>
      </div>
      <p class="hero-note">{t.hero.note}</p>
    </div>
    <div class="hero-demo">
      <p class="try-it">{t.hero.tryIt}</p>
      <Palette t={t} />
    </div>
  </section>

  <section id="features" class="section wrap" aria-labelledby="features-title">
    <div class="section-head">
      <h2 id="features-title">{t.features.title}</h2>
      <p>{t.features.lead}</p>
    </div>
    <ul class="features">
      {
        t.features.items.map((f) => {
          const Icon = featureIcons[f.icon as FeatureIcon];
          return (
            <li>
              <h3>
                <span class="feature-icon">
                  <Icon size={20} aria-hidden="true" />
                </span>
                {f.title}
              </h3>
              <p>{f.body}</p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section id="shortcuts" class="section wrap split" aria-labelledby="shortcuts-title">
    <div class="section-head">
      <h2 id="shortcuts-title">{t.shortcuts.title}</h2>
      <p>{t.shortcuts.lead}</p>
    </div>
    <table class="shortcuts">
      <thead>
        <tr><th scope="col">{t.shortcuts.keysHeader}</th><th scope="col">{t.shortcuts.actionHeader}</th></tr>
      </thead>
      <tbody>
        {
          t.shortcuts.rows.map((r) => (
            <tr>
              <th scope="row">
                <div class="key-list">
                  {r.keys.length === 0 ? (
                    <span class="type-hint">{t.shortcuts.typeLabel}</span>
                  ) : (
                    r.keys.map((k) => <Keys combo={k} />)
                  )}
                </div>
              </th>
              <td>{r.action}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section id="privacy" class="privacy" aria-labelledby="privacy-title">
    <div class="wrap privacy-inner">
      <h2 id="privacy-title">{t.privacy.title}</h2>
      <div>
        <p>{t.privacy.body}</p>
        <ul class="checks">
          {
            t.privacy.points.map((p) => (
              <li>
                <Check size={18} aria-hidden="true" />
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="compare" class="section wrap split" aria-labelledby="compare-title">
    <div class="section-head">
      <h2 id="compare-title">{t.compare.title}</h2>
      <p>{t.compare.lead}</p>
    </div>
    <div class="table-scroll">
      <table class="compare">
        <caption class="sr-only">{t.compare.caption}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{t.compare.featureHeader}</span></th>
            <th scope="col" class="is-wincy">Wincy</th>
            <th scope="col"><Keys combo="Win+V" /></th>
          </tr>
        </thead>
        <tbody>
          {
            t.compare.rows.map(([label, wincy, winv]) => (
              <tr>
                <th scope="row">{label}</th>
                <td class="is-wincy">{wincy}</td>
                <td>{winv}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="install" class="section wrap" aria-labelledby="install-title">
    <div class="section-head">
      <h2 id="install-title">{t.install.title}</h2>
    </div>
    <ol class="steps">
      {
        t.install.steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            {"link" in s && (
              <a class="text-link" href={DOWNLOAD_URL}>
                {s.link}
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            )}
            {"moreInfo" in s && (
              <p class="smartscreen">
                <span class="ui-chip">{s.moreInfo}</span>
                <ArrowRight size={16} aria-hidden="true" />
                <span class="ui-chip is-primary">{s.runAnyway}</span>
              </p>
            )}
          </li>
        ))
      }
    </ol>
    <p class="install-note">
      <Info size={18} aria-hidden="true" />
      {t.install.note}
    </p>
  </section>

  <section id="faq" class="section wrap split" aria-labelledby="faq-title">
    <div class="section-head">
      <h2 id="faq-title">{t.faq.title}</h2>
    </div>
    <div class="faq">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>
              {item.q}
              <ChevronDown size={20} aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="cta wrap" aria-labelledby="cta-title">
    <img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/logo.svg`} alt="" width="72" height="72" loading="lazy" />
    <h2 id="cta-title">{t.hero.title}</h2>
    <div class="hero-actions">
      <a class="btn btn-primary" href={DOWNLOAD_URL}>
        <Download size={20} aria-hidden="true" />
        {t.hero.download}
      </a>
    </div>
    <p class="hero-note">{t.hero.note}</p>
  </section>
</Base>
